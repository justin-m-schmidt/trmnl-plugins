<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800;900&display=block" rel="stylesheet">
<style>
.ds{width:100%;height:100%;align-self:stretch;flex:1 1 auto;min-width:0;min-height:0;container-type:size;
  font-family:'Nunito','Arial Rounded MT Bold',system-ui,sans-serif;font-weight:800;line-height:1.15;
  --ink:#000;--paper:#fff;--flame:#000;--core:#fff;--done:#000;--on:#fff;--bar:#000;--bw:3px}
.ds-in{--kc:var(--paper);--kp:radial-gradient(var(--ink) 1px,transparent 1.3px)}
.screen--2bit .ds-in,.screen--4bit .ds-in{--kc:#b4b4b4;--kp:none}
.screen--lg .ds{--bw:4px}
.ds-in{--u:1px;width:100%;height:100%;box-sizing:border-box;display:flex;flex-direction:column;color:var(--ink);background:var(--paper);
  padding:calc(6*var(--u)) calc(20*var(--u))}
@supports (width:1cqw){
  .ds--full .ds-in{--u:min(calc(100cqw / 760),calc(100cqh / 400))}
  .ds--hh .ds-in{--u:min(calc(100cqw / 760),calc(100cqh / 172))}
  .ds--hv .ds-in{--u:min(calc(100cqw / 364),calc(100cqh / 400))}
  .ds--q .ds-in{--u:min(calc(100cqw / 364),calc(100cqh / 172))}
}
.ds--inv .ds-in{--ink:#fff;--paper:#000;--flame:#fff;--core:#000;--done:#fff;--on:#000;--bar:#fff;border-radius:calc(16*var(--u))}
[class*="screen--color-"] .ds:not(.ds--mono):not(.ds--inv) .ds-in{--flame:#e0241b;--core:#ffd500;--done:#e0241b;--bar:#ffd500;--kc:#ffd500;--kp:none}

.ds-hero{display:flex;align-items:center;gap:calc(var(--hs)*.11)}
.ds-flame{height:calc(var(--hs)*.95);width:auto;flex-shrink:0;display:block}
.ds-fb{fill:var(--flame)}.ds-fc{fill:var(--core)}
.ds-fo{fill:var(--paper);stroke:var(--ink);stroke-width:7;stroke-linejoin:round}
.ds-numcol{display:flex;flex-direction:column;gap:calc(var(--hs)*.05)}
.ds-num{font-size:var(--hs);font-weight:900;line-height:.85;letter-spacing:-.02em}
.ds-lab{font-size:var(--ls);font-weight:800;line-height:1.1;white-space:nowrap}
.ds-ic{width:1.1em;height:1.1em;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:3.4;stroke-linecap:round;stroke-linejoin:round;display:block}
.ds-ic--thin{stroke-width:2.4}
.ds-pill{display:inline-flex;align-items:center;gap:.4em;padding:.3em .8em;border:var(--bw) solid var(--ink);border-radius:999px;
  background:var(--paper);color:var(--ink);font-size:var(--ps);line-height:1.2;white-space:nowrap}
.ds-pill--solid{background:var(--ink);color:var(--paper)}
.ds-sub{font-size:calc(var(--ps)*.85);white-space:nowrap}

.ds-week{display:flex;justify-content:space-between}
.ds-day{display:flex;flex-direction:column;align-items:center;gap:calc(var(--dd)*.12)}
.ds-dl{font-size:calc(var(--dd)*.34);line-height:1.35;padding:0 .4em}
.ds-dl--t{background:var(--ink);color:var(--paper);border-radius:.4em;font-weight:900}
.ds-dot{width:var(--dd);height:var(--dd);border-radius:50%;box-sizing:border-box;display:flex;align-items:center;justify-content:center;
  font-size:calc(var(--dd)*.46);font-weight:800;line-height:1}
.ds-dot .ds-ic{width:56%;height:56%}
.ds-dot--p{background:var(--done);color:var(--on)}
.ds-dot--k{background-color:var(--kc);background-image:var(--kp);background-size:4px 4px}
.ds-dot--k>span{width:68%;height:68%;border-radius:50%;background:var(--paper);display:flex;align-items:center;justify-content:center}
.ds-dot--f{border:var(--bw) solid var(--ink)}
.ds-dot--d{border:var(--bw) dashed var(--ink)}
.ds-dot--m{border:var(--bw) dotted var(--ink)}
.ds-dot--ring{box-shadow:0 0 0 var(--rw,3px) var(--paper),0 0 0 calc(var(--rw,3px)*2) var(--ink)}
.ds-week .ds-dot--x::after,.ds-week .ds-dot--u::after{content:"";width:16%;height:16%;min-width:6px;min-height:6px;border-radius:50%;background:var(--ink)}

.ds-ms{display:flex;flex-direction:column;gap:calc(var(--ms)*.45)}
.ds-ms-h{display:flex;justify-content:space-between;align-items:baseline;font-size:var(--ms);font-weight:700;white-space:nowrap}
.ds-ms-h b{font-weight:900}
.ds-ms-r{display:flex;align-items:center;gap:calc(var(--ms)*.45)}
.ds-chip{display:flex;align-items:center;gap:.3em;padding:.08em .6em;border:var(--bw) solid var(--ink);border-radius:.6em;font-size:calc(var(--ms)*1.1);font-weight:900;line-height:1.3;flex-shrink:0}
.ds-chip--on{background:var(--ink);color:var(--paper)}
.ds-chip .ds-ic{width:.95em;height:.95em}
.ds-track{flex:1;height:calc(var(--ms)*1);box-sizing:border-box;border:var(--bw) solid var(--ink);border-radius:999px;overflow:hidden;background:var(--paper)}
.ds-track i{display:block;height:100%;background:var(--bar)}

.ds-cal{flex:1;min-width:0;box-sizing:border-box;border:var(--bw) solid var(--ink);border-radius:calc(18*var(--u));padding:calc(12*var(--u)) calc(16*var(--u));
  display:flex;flex-direction:column;gap:calc(6*var(--u));--rw:2px;min-height:0}
.ds-cal-h{display:flex;justify-content:space-between;align-items:center;font-size:calc(var(--dd)*.6);font-weight:900}
.ds-cal-s{display:flex;align-items:center;gap:.9em;font-size:.74em;font-weight:800}
.ds-cal-s span{display:flex;align-items:center;gap:.3em}
.ds-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));row-gap:calc(var(--dd)*.16);justify-items:center}
.ds-grid--l{font-size:calc(var(--dd)*.4);row-gap:0}
.ds-grid--d{flex:1;align-content:space-around}

.ds--d4 .ds-in{--hk:.8}.ds--d5 .ds-in{--hk:.66}
/* full */
.ds--full .ds-in{--hs:calc(170*var(--u)*var(--hk,1));--ls:calc(30*var(--u));--ps:calc(24*var(--u));--dd:calc(50*var(--u));--ms:calc(18*var(--u))}
.ds--full .ds-in{justify-content:space-between}
.ds-rowa{display:flex;justify-content:space-between;align-items:center}
.ds-right{display:flex;flex-direction:column;align-items:flex-end;gap:calc(10*var(--u))}
.ds-center{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:calc(var(--hs)*.1)}
.ds-row{display:flex;align-items:center;gap:calc(var(--ls)*.6)}
.ds--full.ds--big .ds-in{--hs:calc(210*var(--u)*var(--hk,1));--ls:calc(34*var(--u))}
.ds--full.ds--detailed .ds-in{--hs:calc(104*var(--u)*var(--hk,1));--ls:calc(22*var(--u));--ps:calc(20*var(--u));--dd:calc(36*var(--u));--ms:calc(16*var(--u))}
.ds-split{flex:1;min-height:0;display:flex;gap:calc(28*var(--u));align-items:stretch;padding:calc(8*var(--u)) 0}
.ds-left{width:calc(300*var(--u));flex-shrink:0;display:flex;flex-direction:column;justify-content:space-between}
.ds-top{display:flex;flex-direction:column;align-items:flex-start;gap:calc(14*var(--u))}
/* half horizontal */
.ds--hh .ds-in{--hs:calc(118*var(--u)*var(--hk,1));--ls:calc(24*var(--u));--ps:calc(20*var(--u));--dd:calc(40*var(--u))}
.ds--hh .ds-in{flex-direction:row;align-items:center;justify-content:space-between}
.ds--hh .ds-week{gap:calc(12*var(--u))}
.ds--hh .ds-right{gap:calc(12*var(--u))}
/* half vertical */
.ds--hv .ds-in{--hs:calc(112*var(--u)*var(--hk,1));--ls:calc(24*var(--u));--ps:calc(20*var(--u));--dd:calc(38*var(--u));--ms:calc(16*var(--u))}
.ds--hv .ds-in{justify-content:space-between;padding:calc(10*var(--u)) calc(8*var(--u))}
.ds-stack{display:flex;flex-direction:column;align-items:center;gap:calc(12*var(--u))}
.ds--hv.ds--detailed .ds-in{--hs:calc(80*var(--u)*var(--hk,1));--ps:calc(18*var(--u));--ls:calc(21*var(--u));--dd:calc(28*var(--u))}
.ds--hv .ds-cal{flex:0 1 auto;padding:calc(10*var(--u)) calc(8*var(--u))}
/* quadrant */
.ds--q .ds-in{--hs:calc(100*var(--u)*var(--hk,1));--ls:calc(19*var(--u));--ps:calc(16*var(--u))}
.ds--q .ds-in{padding:0 calc(8*var(--u))}
</style>
{% assign ds_ok = false %}{% if ds and ds.status %}{% assign ds_ok = true %}{% endif %}
{% if ds_ok %}{% assign ds_n = ds.n %}{% assign ds_status = ds.status %}{% assign ds_detail = ds.detail %}
{% elsif currentStreak.days %}{% assign ds_n = currentStreak.days %}{% assign ds_status = "none" %}{% assign ds_detail = "minimal" %}
{% else %}{% assign ds_n = "–" %}{% assign ds_status = "none" %}{% assign ds_detail = "minimal" %}{% endif %}
{% assign ds_big = false %}{% if ds_detail == "minimal" or ds_status == "lost" or ds_status == "none" or ds.celebrate %}{% assign ds_big = true %}{% endif %}
{% assign ds_digits = ds_n | append: "" | size %}
{% capture ds_cls %}ds--{{ ds_detail }} ds--d{{ ds_digits }}{% if ds_big %} ds--big{% endif %}{% if ds.invert %} ds--inv{% endif %}{% if ds_ok and ds.show.color == false %} ds--mono{% endif %}{% endcapture %}
{% capture ic_check %}<svg class="ds-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{% endcapture %}
{% capture ic_snow %}<svg class="ds-ic ds-ic--thin" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5v19M3.8 7.25l16.4 9.5M3.8 16.75l16.4-9.5M9.2 4.3L12 7l2.8-2.7M9.2 19.7L12 17l2.8 2.7"/></svg>{% endcapture %}
{% capture ic_flag %}<svg class="ds-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 21.5V3.5M6 4.5h12l-3 4.25 3 4.25H6"/></svg>{% endcapture %}
{% capture ic_clock %}<svg class="ds-ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5.5l3.5 2"/></svg>{% endcapture %}
{% capture ic_cross %}<svg class="ds-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg>{% endcapture %}
{% capture ds_flame %}{% if ds_status == "done" or ds_status == "none" %}<svg class="ds-flame" viewBox="-5 -5 110 130" aria-hidden="true"><path class="ds-fb" d="M50 116C22 116 8 96 8 74C8 56 18 44 26 34C28 44 33 50 40 52C36 30 48 12 64 4C62 20 70 30 80 44C88 55 92 64 92 76C92 98 76 116 50 116Z"/><path class="ds-fc" d="M50 104C38 104 30 95 30 84C30 74 37 68 42 60C44 67 48 70 52 71C52 64 55 58 60 54C62 62 70 70 70 84C70 95 62 104 50 104Z"/></svg>{% else %}<svg class="ds-flame" viewBox="-5 -5 110 130" aria-hidden="true"><path class="ds-fo" d="M50 116C22 116 8 96 8 74C8 56 18 44 26 34C28 44 33 50 40 52C36 30 48 12 64 4C62 20 70 30 80 44C88 55 92 64 92 76C92 98 76 116 50 116Z"/></svg>{% endif %}{% endcapture %}
{% capture ds_hero %}<div class="ds-hero">{{ ds_flame }}<div class="ds-num">{{ ds_n }}</div></div>{% endcapture %}
{% capture ds_hero_l %}<div class="ds-hero">{{ ds_flame }}<div class="ds-numcol"><div class="ds-num">{{ ds_n }}</div><div class="ds-lab">day streak</div></div></div>{% endcapture %}
{% capture ds_pill %}{% if ds.celebrate %}<div class="ds-pill">{{ ic_flag }}<span>Milestone reached</span></div>{% elsif ds_status == "done" %}<div class="ds-pill">{{ ic_check }}<span>Done today</span></div>{% elsif ds_status == "due" %}<div class="ds-pill{% unless ds.quiet %} ds-pill--solid{% endunless %}">{{ ic_clock }}<span>Lesson due</span></div>{% elsif ds_status == "lost" %}<div class="ds-pill ds-pill--solid">{{ ic_clock }}<span>Start a new streak</span></div>{% endif %}{% endcapture %}
{% capture ds_sub %}{% if ds.celebrate %}<div class="ds-sub">Next: {{ ds.ms.after }} in {{ ds.ms.after_togo }} days</div>{% elsif ds_status == "due" and ds.show.hours %}<div class="ds-sub">{{ ds.time_left }}</div>{% endif %}{% endcapture %}
{% capture ds_week %}{% if ds_ok and ds.show.week %}<div class="ds-week">{% for w in ds.week %}<div class="ds-day"><div class="ds-dl{% if w.t %} ds-dl--t{% endif %}">{{ w.l }}</div><div class="ds-dot ds-dot--{{ w.s }}{% if w.t and w.s == 'p' %} ds-dot--ring{% endif %}">{% if w.s == "p" %}{{ ic_check }}{% elsif w.s == "f" %}{{ ic_snow }}{% elsif w.s == "m" %}{{ ic_cross }}{% endif %}</div></div>{% endfor %}</div>{% endif %}{% endcapture %}
{% capture ds_ms %}{% if ds_ok and ds.show.milestone %}<div class="ds-ms"><div class="ds-ms-h"><span>Next milestone</span><b>{{ ds.ms.togo }} {{ ds.ms.unit }} to go</b></div><div class="ds-ms-r"><div class="ds-chip ds-chip--on">{{ ds.ms.prev }}</div><div class="ds-track"><i style="width:{{ ds.ms.pct }}%"></i></div><div class="ds-chip">{{ ic_flag }}<span>{{ ds.ms.next }}</span></div></div></div>{% endif %}{% endcapture %}
{% capture ds_cal %}{% if ds_ok %}<div class="ds-cal"><div class="ds-cal-h"><span>{{ ds.cal.month }}</span><div class="ds-cal-s"><span>{{ ic_check }}{{ ds.cal.practised }}</span><span>{{ ic_snow }}{{ ds.cal.frozen }}</span></div></div><div class="ds-grid ds-grid--l">{% for l in ds.cal.labels %}<div>{{ l }}</div>{% endfor %}</div><div class="ds-grid ds-grid--d">{% for c in ds.cal.cells %}{% if c.d == 0 %}<div></div>{% else %}<div class="ds-dot ds-dot--{{ c.s }}{% if c.t and c.s == 'p' %} ds-dot--ring{% endif %}">{% if c.s == "f" %}{{ ic_snow }}{% else %}<span>{{ c.d }}</span>{% endif %}</div>{% endif %}{% endfor %}</div></div>{% endif %}{% endcapture %}
{% capture ds_bar %}<div class="title_bar"><img class="image" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='-5 -5 110 130'%3E%3Cpath d='M50 116C22 116 8 96 8 74C8 56 18 44 26 34C28 44 33 50 40 52C36 30 48 12 64 4C62 20 70 30 80 44C88 55 92 64 92 76C92 98 76 116 50 116Z'/%3E%3Cpath fill='%23fff' d='M50 104C38 104 30 95 30 84C30 74 37 68 42 60C44 67 48 70 52 71C52 64 55 58 60 54C62 62 70 70 70 84C70 95 62 104 50 104Z'/%3E%3C/svg%3E"><span class="title">{{ trmnl.plugin_settings.instance_name }}</span>{% unless ds_ok and ds.show.username == false %}<span class="instance">{{ ds.username | default: username }}</span>{% endunless %}</div>{% endcapture %}
