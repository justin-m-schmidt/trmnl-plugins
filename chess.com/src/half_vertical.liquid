<div class="layout layout--col gap--space-between">

  <!-- Top: 2x2 rating grid -->
  <div class="grid grid--cols-2">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge value--tnums" data-fit-value="true">{{ fide }}</span>
        <span class="label label--small">FIDE</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge value--tnums" data-fit-value="true">{{ chess_bullet.best.rating }}</span>
        <span class="label label--small">Bullet</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge value--tnums" data-fit-value="true">{{ chess_blitz.best.rating }}</span>
        <span class="label label--small">Blitz</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge value--tnums" data-fit-value="true">{{ chess_rapid.best.rating }}</span>
        <span class="label label--small">Rapid</span>
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <!-- Middle: Bullet win rate -->
  <div class="flex flex--col gap--small">
    {% assign bullet_total = chess_bullet.record.win | plus: chess_bullet.record.draw | plus: chess_bullet.record.loss %}
    {% assign bullet_win_pct = chess_bullet.record.win | times: 100 | divided_by: bullet_total %}
    <div class="flex flex--row gap--space-between">
      <span class="label">Bullet Win Rate</span>
      <span class="value value--small value--tnums">{{ bullet_win_pct }}%</span>
    </div>
    <div class="progress-bar progress-bar--large" data-progress="{{ bullet_win_pct }}"></div>
    <div class="flex flex--row gap--medium">
      <span class="label label--xsmall">{{ chess_bullet.record.win | divided_by: 1000.0 | round: 1 }}k W</span>
      <span class="label label--xsmall">{{ chess_bullet.record.draw }} D</span>
      <span class="label label--xsmall">{{ chess_bullet.record.loss | divided_by: 1000.0 | round: 1 }}k L</span>
    </div>
  </div>

  <!-- Middle: Blitz win rate -->
  <div class="flex flex--col gap--small">
    {% assign blitz_total = chess_blitz.record.win | plus: chess_blitz.record.draw | plus: chess_blitz.record.loss %}
    {% assign blitz_win_pct = chess_blitz.record.win | times: 100 | divided_by: blitz_total %}
    <div class="flex flex--row gap--space-between">
      <span class="label">Blitz Win Rate</span>
      <span class="value value--small value--tnums">{{ blitz_win_pct }}%</span>
    </div>
    <div class="progress-bar progress-bar--large" data-progress="{{ blitz_win_pct }}"></div>
    <div class="flex flex--row gap--medium">
      <span class="label label--xsmall">{{ chess_blitz.record.win | divided_by: 1000.0 | round: 1 }}k W</span>
      <span class="label label--xsmall">{{ chess_blitz.record.draw | divided_by: 1000.0 | round: 1 }}k D</span>
      <span class="label label--xsmall">{{ chess_blitz.record.loss | divided_by: 1000.0 | round: 1 }}k L</span>
    </div>
  </div>

  <div class="divider"></div>

  <!-- Bottom: Tactics + Puzzle Rush -->
  <div class="grid grid--cols-2">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--medium value--tnums">{{ tactics.highest.rating }}</span>
        <span class="label label--small">Tactics Best</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--medium value--tnums">{{ puzzle_rush.best.score }}</span>
        <span class="label label--small">Puzzle Rush</span>
      </div>
    </div>
  </div>

</div>

<div class="title_bar">
  <div class="image image-stroke image-stroke--large">
    <svg xmlns="http://www.w3.org/2000/svg" version="1.0" width="16pt" height="19pt" viewBox="0 0 934.000000 1280.000000" preserveAspectRatio="xMidYMid meet">
      <g transform="translate(0.000000,1280.000000) scale(0.100000,-0.100000)" fill="#000000" stroke="none">
        <path d="M4457 12790 c-604 -63 -1173 -404 -1445 -865 -125 -212 -188 -447 -199 -737 -14 -378 72 -749 268 -1156 38 -78 69 -144 69 -146 0 -3 -73 -40 -162 -84 -633 -308 -1041 -751 -1213 -1318 -20 -65 -48 -184 -62 -264 -24 -131 -27 -170 -27 -410 -1 -283 5 -341 59 -552 182 -709 523 -1157 1035 -1359 l111 -44 -33 -18 c-18 -10 -100 -55 -183 -99 -540 -291 -991 -608 -1314 -923 -518 -505 -874 -1107 -1099 -1855 -143 -475 -222 -970 -253 -1585 -12 -240 -7 -1127 7 -1297 l7 -78 4647 0 4647 0 7 83 c14 182 19 1064 7 1302 -61 1250 -333 2129 -882 2860 -436 581 -1064 1094 -1862 1523 -87 46 -156 86 -155 87 2 2 34 15 73 30 304 114 644 404 850 725 325 505 401 1326 184 1958 -65 187 -169 382 -288 537 -68 90 -255 278 -351 354 -192 152 -414 284 -652 386 l-87 37 35 61 c121 212 239 491 288 683 52 202 61 275 60 499 0 179 -3 225 -22 313 -44 201 -101 340 -212 517 -294 468 -716 741 -1271 820 -135 20 -457 28 -582 15z"/>
