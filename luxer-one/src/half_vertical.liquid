{% if state == "auth" or state == "error" %}
  {% render "lx_message", state: state, step: step, email: email, field: field, error: error %}
{% elsif count == 0 %}
<div class="layout layout--col layout--center" style="gap:12px;">
  {% render "lx_locker", size: 180 %}
  <span class="value">All picked up</span>
  <span class="label" style="text-align:center;">No packages waiting in your {% if multi %}lockers{% else %}locker{% endif %}</span>
  {% if picked_total and picked_total > 0 %}<span class="label" style="border:2px solid #000; border-radius:999px; padding:3px 16px;"><span style="font-weight:700;">{{ picked_total }}{% if picked_more %}+{% endif %}</span> picked up so far</span>{% endif %}
  {% if notice and notice != "" %}{% render "lx_people", people: people, small: true %}{% endif %}
</div>
{% else %}
<div class="layout layout--col layout--stretch-x layout--top" style="gap:8px;">
  {% assign qr = false %}{% if pickup_url and pickup_url != "" %}{% assign qr = true %}{% endif %}
  <div style="display:flex; flex-direction:column; align-items:center; gap:4px; width:100%;">
    <div style="display:flex; align-items:center; gap:12px;">
      {% if qr %}{% render "lx_package", size: 60 %}{% else %}{% render "lx_package", size: 110 %}{% endif %}
      <span class="value {% if qr %}value--xlarge{% else %}value--xxxlarge{% endif %}">{{ count }}</span>
    </div>
    <span class="label" style="font-weight:700;">{{ noun | capitalize }} to pick up</span>
    {% if multi %}{% render "lx_people", people: people, small: true %}{% endif %}
  </div>
  <div style="width:100%; border-top:2px solid #000; padding-top:4px;">
    {% if qr %}{% render "lx_list", packages: packages, count: count, rows: 2, pad: 6 %}{% else %}{% render "lx_list", packages: packages, count: count, rows: 3, pad: 7 %}{% endif %}
  </div>
  {% if qr %}{% render "lx_qr", url: pickup_url, size: pickup_qr %}{% endif %}
</div>
{% endif %}
{% render "lx_title_bar", state: state, sample: sample, demo: demo, updated: updated, notice: notice %}
{% if hide %}<script>window.TRMNL_SKIP_DISPLAY = true;</script>{% endif %}
