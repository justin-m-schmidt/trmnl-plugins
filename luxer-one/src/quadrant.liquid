{% assign xl = false %}{% if trmnl.device.width > 1000 or trmnl.device.height > 1000 %}{% assign xl = true %}{% endif %}
{% if state == "auth" or state == "error" %}
  {% render "lx_message", state: state, step: step, email: email, field: field, error: error, compact: true, xl: xl %}
{% elsif count == 0 %}
<div class="layout layout--row layout--center lg:portrait:layout--col gap--[16px]">
  {% if xl %}{% render "lx_locker", size: 150 %}{% else %}{% render "lx_locker", size: 100 %}{% endif %}
  <div class="flex flex--col flex--left gap--[2px]">
    <span class="title lg:title--xlarge">All picked up</span>
    {% if picked_total and picked_total > 0 %}<span class="label label--small lg:label--large"><span><span style="font-weight:700;">{{ picked_total }}{% if picked_more %}+{% endif %}</span> picked up so far</span></span>{% else %}<span class="label label--small lg:label--large">No packages waiting</span>{% endif %}
    {% if notice and notice != "" %}{% render "lx_people", people: people, small: true, align: "left" %}{% endif %}
  </div>
</div>
{% else %}
<div class="layout layout--row layout--center lg:portrait:layout--col gap--[14px]">
  {% if xl %}{% render "lx_package", size: 150 %}{% else %}{% render "lx_package", size: 100 %}{% endif %}
  <div class="flex flex--col flex--left gap--[0px]">
    <span class="value value--xxlarge lg:value--mega">{{ count }}</span>
    <span class="label label--small lg:label--large" style="font-weight:700;">{{ noun | capitalize }} to pick up</span>
    {% if multi %}{% render "lx_people", people: people, small: true, align: "left" %}{% endif %}
  </div>
</div>
{% endif %}
{% render "lx_title_bar", state: state, sample: sample, demo: demo, updated: updated, notice: notice %}
{% if hide %}<script>window.TRMNL_SKIP_DISPLAY = true;</script>{% endif %}
