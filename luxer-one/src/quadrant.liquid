{% if state == "auth" or state == "error" %}
  {% render "lx_message", state: state, step: step, email: email, field: field, error: error, compact: true %}
{% elsif count == 0 %}
<div class="layout layout--row layout--center" style="gap:16px;">
  {% render "lx_locker", size: 100 %}
  <div style="display:flex; flex-direction:column; gap:2px;">
    <span class="title">All picked up</span>
    {% if picked_total and picked_total > 0 %}<span class="label label--small"><span style="font-weight:700;">{{ picked_total }}{% if picked_more %}+{% endif %}</span> picked up so far</span>{% else %}<span class="label label--small">No packages waiting</span>{% endif %}
    {% if notice and notice != "" %}{% render "lx_people", people: people, small: true, align: "flex-start" %}{% endif %}
  </div>
</div>
{% else %}
<div class="layout layout--row layout--center" style="gap:14px;">
  {% render "lx_package", size: 100 %}
  <div style="display:flex; flex-direction:column; gap:0;">
    <span class="value value--xxlarge">{{ count }}</span>
    <span class="label label--small" style="font-weight:700;">{{ noun | capitalize }} to pick up</span>
    {% if multi %}{% render "lx_people", people: people, small: true, align: "flex-start" %}{% endif %}
  </div>
</div>
{% endif %}
{% render "lx_title_bar", state: state, sample: sample, demo: demo, updated: updated, notice: notice %}
{% if hide %}<script>window.TRMNL_SKIP_DISPLAY = true;</script>{% endif %}
