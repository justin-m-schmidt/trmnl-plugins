{% if state == "auth" or state == "error" %}
  {% render "lx_message", state: state, step: step, email: email, field: field, error: error, compact: true %}
{% elsif count == 0 %}
<div class="layout layout--row layout--center" style="gap:28px;">
  {% render "lx_locker", size: 130 %}
  <div style="display:flex; flex-direction:column; gap:4px;">
    <span class="value">All picked up</span>
    <span class="label">No packages waiting in your {% if multi %}lockers{% else %}locker{% endif %}</span>
    {% if picked_total and picked_total > 0 %}<span class="label label--small"><span style="font-weight:700;">{{ picked_total }}{% if picked_more %}+{% endif %}</span> picked up so far</span>{% endif %}
    {% if notice and notice != "" %}{% render "lx_people", people: people, small: true, align: "flex-start" %}{% endif %}
  </div>
</div>
{% else %}
<div class="layout layout--col layout--stretch-x">
  <div style="display:flex; align-items:center; gap:22px; width:100%;">
    <div style="flex:none; width:{% if pickup_url and pickup_url != "" %}200{% else %}270{% endif %}px; display:flex; flex-direction:column; align-items:center; gap:4px;">
      <div style="display:flex; align-items:center; gap:12px;">
        {% render "lx_package", size: 96 %}
        <span class="value value--xxlarge">{{ count }}</span>
      </div>
      <span class="label label--small" style="font-weight:700;">{{ noun | capitalize }} to pick up</span>
      {% if multi %}{% render "lx_people", people: people, small: true %}{% endif %}
    </div>
    <div style="flex:1; min-width:0; border-left:2px solid #000; padding-left:20px;">
      {% render "lx_list", packages: packages, count: count, rows: 2, pad: 5 %}
    </div>
    {% if pickup_url and pickup_url != "" %}{% render "lx_qr", url: pickup_url, size: pickup_qr, compact: true %}{% endif %}
  </div>
</div>
{% endif %}
{% render "lx_title_bar", state: state, sample: sample, demo: demo, updated: updated, notice: notice %}
{% if hide %}<script>window.TRMNL_SKIP_DISPLAY = true;</script>{% endif %}
