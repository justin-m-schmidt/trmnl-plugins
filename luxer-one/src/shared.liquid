{% template lx_package %}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ size }}" height="{{ size }}" viewBox="0 0 120 120" fill="none" stroke="#000" stroke-width="{{ stroke | default: 6 }}" stroke-linejoin="round" stroke-linecap="round" style="flex:none;">
  <path d="M60 12 L104 34 L104 86 L60 108 L16 86 L16 34 Z" fill="#fff"></path>
  <path d="M16 34 L60 56 L104 34"></path>
  <path d="M60 56 L60 108"></path>
  <path d="M38 23 L82 45 L82 62"></path>
</svg>
{% endtemplate %}

{% template lx_locker %}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ size }}" height="{{ size }}" viewBox="0 0 120 120" fill="none" stroke="#000" stroke-width="{{ stroke | default: 5 }}" stroke-linejoin="round" stroke-linecap="round" style="flex:none;">
  <rect x="40" y="12" width="68" height="88" rx="3" fill="#fff"></rect>
  <rect x="54" y="26" width="40" height="60" stroke-width="3"></rect>
  <path d="M40 12 L54 26 M108 12 L94 26 M40 100 L54 86 M108 100 L94 86" stroke-width="3"></path>
  <path d="M40 12 L14 24 L14 112 L40 100 Z" fill="#fff"></path>
  <circle cx="22" cy="68" r="2.5" fill="#000" stroke-width="3"></circle>
  <path d="M66 106 L112 106" stroke-width="3" stroke-dasharray="1 7"></path>
</svg>
{% endtemplate %}

{% template lx_list %}
<div style="display:flex; flex-direction:column; width:100%;">
  {% for p in packages limit: rows %}
  <div style="display:flex; align-items:center; gap:12px; padding:{{ pad | default: 9 }}px 0; {% unless forloop.first %}border-top:1px solid #000;{% endunless %}">
    {% if big %}{% assign mark = 46 %}{% else %}{% assign mark = 32 %}{% endif %}
    {% if p.icon != "" %}<img src="{{ p.icon }}" alt="{{ p.carrier }}" style="flex:none; width:{{ mark }}px; height:{{ mark }}px;">{% else %}{% render "lx_package", size: mark, stroke: 8 %}{% endif %}
    <div style="flex:1; min-width:0; display:flex; flex-direction:column; gap:2px;">
      <span class="title{% unless big %} title--small{% endunless %}" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ p.title }}</span>
      {% if p.detail != "" %}<span class="label{% unless big %} label--small{% endunless %}" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ p.detail }}</span>{% endif %}
    </div>
    {% if p.who != "" %}<span class="label{% unless big %} label--small{% endunless %}" style="flex:none; font-weight:700; background:#000; color:#fff; border-radius:6px; padding:2px 9px;">{{ p.who }}</span>{% endif %}
    {% if p.code != "" %}<span class="label" style="flex:none; font-weight:700; border:2px solid #000; border-radius:6px; padding:2px 9px;">{{ p.code }}</span>{% endif %}
  </div>
  {% endfor %}
  {% if count > rows %}
  {% assign more = count | minus: rows %}
  <div style="padding-top:{{ pad | default: 9 }}px; border-top:1px solid #000;"><span class="label label--small">+ {{ more }} more</span></div>
  {% endif %}
</div>
{% endtemplate %}

{% template lx_qr %}
<div style="display:flex; align-items:center; justify-content:space-between; gap:12px; border:2px solid #000; border-radius:14px; padding:6px 6px 6px 14px; background:#fff;{% if compact %} flex:none;{% else %} width:100%;{% endif %} box-sizing:border-box;">
  <div style="display:flex; flex-direction:column; gap:2px; min-width:0;">
    {% if compact %}
    <span class="label" style="font-weight:700; line-height:1.15;">Scan<br>for<br>codes</span>
    {% else %}
    <span class="title title--small" style="white-space:nowrap;">Scan for codes</span>
    <span class="label label--small">Opens them on your phone</span>
    {% endif %}
  </div>
  <div style="flex:none; width:{{ size }}px; height:{{ size }}px;">{{ url | qr_code }}</div>
</div>
{% endtemplate %}

{% template lx_people %}
<div style="display:flex; flex-wrap:wrap; justify-content:{{ align | default: "center" }}; gap:2px 16px;">
  {% for q in people %}<span class="label{% if small %} label--small{% endif %}" style="white-space:nowrap;">{{ q.name }}&nbsp;<span style="font-weight:700;">{% if q.note %}· {{ q.note }}{% else %}{{ q.count }}{% endif %}</span></span>{% endfor %}
</div>
{% endtemplate %}

{% template lx_message %}
<div class="layout layout--col layout--center" style="gap:{% if compact %}6{% else %}12{% endif %}px;">
  {% unless compact %}{% render "lx_locker", size: 96 %}{% endunless %}
  {% if state == "error" %}
    <span class="title{% if compact %} title--small{% endif %}">Couldn't load Luxer One</span>
    <span class="{% if compact %}label label--small{% else %}description{% endif %}" style="text-align:center; max-width:560px;">{{ error }}</span>
    {% unless compact %}<span class="label label--small">Will try again on the next refresh.</span>{% endunless %}
  {% else %}
    <span class="title{% if compact %} title--small{% endif %}">{% if step == "rejected" %}That code didn't work{% elsif step == "expired" %}Sign in again{% else %}Check your email{% endif %}</span>
    <span class="{% if compact %}label label--small{% else %}description{% endif %}" style="text-align:center; max-width:560px;">{% if step == "rejected" %}A new sign-in code is on its way to {{ email }}.{% elsif step == "expired" %}Luxer One signed this screen out and emailed a new code to {{ email }}.{% else %}Luxer One emailed a sign-in code to {{ email }}.{% endif %}</span>
    <span class="label label--small" style="text-align:center;">Enter it as {{ field | default: "Verification code" }} in this plugin's settings on trmnl.com.</span>
  {% endif %}
</div>
{% endtemplate %}

{% template lx_title_bar %}
<div class="title_bar">
  <div class="image image-stroke image-stroke--large">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 120 120" fill="none" stroke="#000000" stroke-width="10" stroke-linejoin="round" stroke-linecap="round"><path d="M60 12 L104 34 L104 86 L60 108 L16 86 L16 34 Z"/><path d="M16 34 L60 56 L104 34"/><path d="M60 56 L60 108"/></svg>
  </div>
  <span class="title">Luxer One</span>
  <span class="instance">{% if state == "error" %}Luxer One error{% elsif state == "auth" %}Sign-in needed{% elsif notice and notice != "" %}{{ notice }}{% elsif sample %}Sample data · add your email{% elsif demo %}Preview{% else %}Updated {{ updated }}{% endif %}</span>
</div>
{% endtemplate %}
