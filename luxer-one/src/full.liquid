{% assign xl = false %}{% if trmnl.device.width > 1000 or trmnl.device.height > 1000 %}{% assign xl = true %}{% endif %}
{% assign tall = false %}{% if trmnl.device.orientation == "portrait" or trmnl.device.height > trmnl.device.width %}{% assign tall = true %}{% endif %}
{% assign qr = false %}{% if pickup_url and pickup_url != "" %}{% assign qr = true %}{% endif %}{% assign qsize = pickup_qr %}{% if xl %}{% assign qsize = pickup_qr | times: 8 | divided_by: 5 %}{% endif %}
{% if state == "auth" or state == "error" %}
  {% render "lx_message", state: state, step: step, email: email, field: field, error: error, xl: xl %}
{% elsif count == 0 %}
<div class="layout layout--col layout--center gap--[14px]">
  {% if xl %}{% render "lx_locker", size: 330 %}{% else %}{% render "lx_locker", size: 210 %}{% endif %}
  <span class="value value--large lg:value--xlarge">All picked up</span>
  <span class="label lg:label--large">No packages waiting in your {% if multi %}lockers{% else %}locker{% endif %}</span>
  {% if picked_total and picked_total > 0 %}<span class="label label--outline lg:label--large"><span><span class="text--bold">{{ picked_total }}{% if picked_more %}+{% endif %}</span> picked up so far</span></span>{% endif %}
  {% if notice and notice != "" %}{% render "lx_people", people: people %}{% endif %}
</div>
{% else %}
<div class="layout layout--col layout--stretch-x">
  <div class="flex flex--row flex--center-y portrait:flex--col portrait:flex--center-x gap--[36px] w--full">
    <div class="flex flex--col flex--center-x gap--[10px] w--[39cqw] portrait:w--full flex-none">
      <div class="flex flex--row flex--center-y gap--[14px]">
        {% if xl %}{% render "lx_package", size: 240 %}{% else %}{% render "lx_package", size: 150 %}{% endif %}
        <span class="value value--xxxlarge lg:value--giga">{{ count }}</span>
      </div>
      <span class="label lg:label--large text--bold">{{ noun | capitalize }} to pick up</span>
      {% if multi %}{% render "lx_people", people: people %}{% endif %}
    </div>
    <div class="flex flex--col gap--[12px] stretch-x portrait:w--full" style="min-width:0;{% if tall %} border-top:2px solid #000; padding-top:16px;{% else %} border-left:2px solid #000; padding-left:28px;{% endif %}">
      {% assign rows = 4 %}{% if qr %}{% assign rows = 3 %}{% endif %}{% if tall %}{% assign rows = rows | plus: 2 %}{% endif %}
      {% if qr %}
      {% render "lx_list", packages: packages, count: count, rows: rows, big: true, pad: 8, xl: xl %}
      {% render "lx_qr", url: pickup_url, size: qsize %}
      {% else %}
      {% render "lx_list", packages: packages, count: count, rows: rows, big: true, pad: 11, xl: xl %}
      {% endif %}
    </div>
  </div>
</div>
{% endif %}
{% render "lx_title_bar", state: state, sample: sample, demo: demo, updated: updated, notice: notice %}
{% if hide %}<script>window.TRMNL_SKIP_DISPLAY = true;</script>{% endif %}
