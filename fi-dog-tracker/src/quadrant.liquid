{% assign fi_view = view | default: trmnl.plugin_settings.custom_fields_values.view | default: "home" %}
{% if error %}
  {% render "fi_error", error: error %}
{% elsif fi_view == "home" %}
<div class="layout fi-home-layout">
  {% render "fi_home", size: "q", today: today, strain: strain, week: week %}
</div>
{% elsif fi_view == "walk" %}
<div class="layout layout--col layout--stretch-x fi-cq">
  <div class="flex flex--row flex--center-y gap--medium w--full">
    {% render "fi_ring", size: "q", state: walk.state, big: walk.big, sub: walk.sub, line1: walk.line1, line2: walk.line2, dash: walk.ring.dash %}
    <div class="flex flex--col flex--left gap--xsmall grow">
      <span class="label text--bold lg:label--large">{{ walk.label }}</span>
      <span class="label label--small lg:label--base">{{ walk.status }}</span>
      <span class="label label--small lg:label--base">Today: {{ walk.strip.summary }}</span>
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--col layout--stretch-x gap--small">
  <div class="flex flex--col">
    <span class="value value--large lg:value--xxlarge value--tnums">{{ today.steps_label }}</span>
    <span class="label label--small lg:label--base">Steps today · {{ today.pct }}% of goal</span>
  </div>
  <div class="progress-bar progress-bar--small">
    <div class="track fi-cq-x"><div class="fill w--[{{ today.bar_pct | round | at_least: 0 | at_most: 100 }}cqw]" data-fi="activity"></div></div>
  </div>
  <div class="grid grid--cols-2">
    <div class="flex flex--col">
      <span class="value value--small lg:value--large value--tnums">{{ today.sleep }}</span>
      <span class="label label--small lg:label--base">{{ today.sleep_title | default: "Sleep" }}</span>
    </div>
    <div class="flex flex--col">
      <span class="value value--small lg:value--large value--tnums">{{ today.nap }}</span>
      <span class="label label--small lg:label--base">Naps</span>
    </div>
  </div>
</div>
{% endif %}
{% render "fi_title_bar", view: fi_view, compact: true, pet: pet, walk: walk, updated: updated, demo: demo, sample: sample, error: error %}
