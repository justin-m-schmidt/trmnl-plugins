{% assign fi_view = view | default: trmnl.plugin_settings.custom_fields_values.view | default: "home" %}
{% if error %}
  {% render "fi_error", error: error %}
{% elsif fi_view == "home" %}
<div class="layout fi-home-layout">
  {% render "fi_home", size: "hv", today: today, strain: strain, week: week %}
</div>
{% elsif fi_view == "walk" %}
<div class="layout layout--col layout--stretch-x layout--top gap--small fi-cq">
  <div class="flex flex--col flex--center-x gap--small w--full">
    {% render "fi_ring", size: "hv", state: walk.state, big: walk.big, sub: walk.sub, line1: walk.line1, line2: walk.line2, dash: walk.ring.dash %}
    {% render "fi_status", state: walk.state, status: walk.status %}
    <span class="label label--small hidden lg:visible">Walk due after {{ walk.limit }} without a walk</span>
  </div>
  <div class="divider"></div>
  {% render "fi_strip", strip: walk.strip, axis: walk.axis %}
</div>
{% else %}
<div class="layout layout--col layout--stretch-x layout--top gap--small">
  <div class="grid grid--cols-2">
    <div class="flex flex--col">
      <span class="value value--base lg:value--xlarge value--tnums">{{ today.steps_label }}</span>
      <span class="label label--small lg:label--base">Steps today</span>
    </div>
    <div class="flex flex--col">
      <span class="value value--base lg:value--xlarge value--tnums">{{ today.sleep }}</span>
      <span class="label label--small lg:label--base">{{ today.sleep_title | default: "Sleep" }} · +{{ today.nap }} naps</span>
    </div>
  </div>
  <div class="progress-bar progress-bar--small">
    <div class="content">
      <span class="label label--small lg:label--base">{{ today.pct }}% of {{ today.goal_label }} goal</span>
      <span class="value value--xxsmall lg:value--small">{{ today.distance }}</span>
    </div>
    <div class="track"><div class="fill" data-fi="activity" style="width: {{ today.bar_pct }}%"></div></div>
  </div>
  <span class="label label--small lg:label--base">Steps · 7 days (avg {{ week.avg_steps }})</span>
  <div id="fi-steps-hv" class="w--full grow basis--0"></div>
  <span class="label label--small lg:label--base">Sleep + naps (h) · avg {{ week.avg_sleep }}</span>
  <div id="fi-sleep-hv" class="w--full grow basis--0"></div>
</div>
<script>
  var fiDaysHV = {{ days | json }};
  fiChart("fi-steps-hv", "steps", fiDaysHV, {{ today.goal | default: 0 }}, { fill: true, font: 12, narrow: true, ticks: 3 });
  fiChart("fi-sleep-hv", "sleep", fiDaysHV, 0, { fill: true, font: 12, narrow: true, ticks: 3 });
</script>
{% endif %}
{% render "fi_title_bar", view: fi_view, compact: true, pet: pet, walk: walk, updated: updated, demo: demo, sample: sample, error: error %}
