{% assign fi_view = view | default: trmnl.plugin_settings.custom_fields_values.view | default: "home" %}
<style>
  /* Fi Homescreen style: the Fi app's home cards on its plain grey background. Solid greys on
     grayscale screens, the app's own colours on colour screens (fi-color), and black outlines on
     1-bit screens (fi-1bit), which cannot show a solid grey without TRMNL's dither pattern.
     Text uses the framework's title, value and label classes; this block only lays out the cards
     and draws the ring, slider and art, sized from each card (cqh/cqw). */
  .view:has(.fi-home) { background: #DADADA; }
  .view:has(.fi-home.fi-color) { background: #F2F1EF; }
  .view:has(.fi-home.fi-1bit) { background: #FFFFFF; }
  .view:has(.fi-home) .title_bar { background: transparent !important; background-image: none !important; }
  .fi-home-layout { display: flex; flex-direction: column; align-items: stretch; justify-content: stretch; }
  .fi-home { --fi-card: #FFFFFF; --fi-muted: #555; --fi-track: #D2D2D2; --fi-ring: #000; --fi-ring-text: #000;
    --fi-slider-a: #EDEDED; --fi-slider-b: #999; --fi-knob: #777; --fi-cloud-a: #8A8A8A; --fi-cloud-b: #E2E2E2; --fi-zz: #C6C6C6;
    --fi-pod-side: #D0D0D0; --fi-pod-mid: #7C7C7C; --fi-trophy: #A6A6A6; --fi-chev: #999;
    flex: 1; width: 100%; min-height: 0; display: flex; flex-direction: column; gap: 12px; }
  .fi-home.fi-color { --fi-muted: #8E8782; --fi-track: #D2F0DE; --fi-ring: #5ECB76; --fi-ring-text: #3E9F5A;
    --fi-slider-a: #E7E4E1; --fi-slider-b: #B8B3AE; --fi-knob: #BDB8B3; --fi-cloud-a: #C4A8F6; --fi-cloud-b: #F1ECFC; --fi-zz: #E9E0FB;
    --fi-pod-side: #F7DA9C; --fi-pod-mid: #F0A73F; --fi-trophy: #F4D48C; --fi-chev: #AAA39E; }
  .fi-home.fi-1bit { --fi-muted: #000; --fi-track: #FFF; --fi-slider-a: #FFF; --fi-slider-b: #FFF; --fi-knob: #000;
    --fi-cloud-a: #000; --fi-cloud-b: #FFF; --fi-zz: #000; --fi-pod-side: #FFF; --fi-pod-mid: #000; --fi-trophy: #000; --fi-chev: #000; }
  .fi-1bit .fi-card { border: 2px solid #000; }
  .fi-1bit .fi-slider { border: 2px solid #000; box-sizing: border-box; }
  .fi-ol { display: none; }
  /* SVG paints from the palette above, as classes rather than inline styles. */
  .fi-s-track { stroke: var(--fi-track); }
  .fi-s-ring { stroke: var(--fi-ring); }
  .fi-f-ring-text { fill: var(--fi-ring-text); }
  .fi-f-muted { fill: var(--fi-muted); }
  .fi-s-chev { stroke: var(--fi-chev); }
  .fi-f-cloud-a { fill: var(--fi-cloud-a); }
  .fi-f-cloud-b { fill: var(--fi-cloud-b); }
  .fi-s-zz { stroke: var(--fi-zz); }
  .fi-f-pod-side { fill: var(--fi-pod-side); }
  .fi-f-pod-mid { fill: var(--fi-pod-mid); }
  .fi-trophy { fill: var(--fi-trophy); stroke: var(--fi-trophy); }
  /* Positions and widths come from the framework's w--[Ncqw] classes: inside a width
     container, N cqw is N% of it. A lane puts a spacer of that width before the mark. */
  .fi-cq-x { container-type: inline-size; }
  .fi-lane { position: absolute; inset: 0; display: flex; }
  .fi-1bit .fi-ol { display: inline; }
  .fi-card { container-type: size; background: var(--fi-card); border-radius: 18px; position: relative; overflow: hidden;
    box-sizing: border-box; min-width: 0; min-height: 0; padding: 10px 18px; display: flex; flex-direction: column; }
  .fi-row { flex: 1; display: flex; gap: 12px; min-height: 0; }
  .fi-row .fi-card { flex: 1; }
  .fi-chev { position: absolute; top: 14px; right: 14px; width: 9px; height: 16px; }
  .fi-capline { display: flex; flex-wrap: wrap; justify-content: space-between; column-gap: 12px; padding-right: 14px; }
  /* Steps card: text and figures keep their size; the donut takes the room that is left. */
  .fi-steps { flex: 1.25; flex-direction: row; align-items: center; gap: 4cqw; }
  .fi-steps-text { flex: none; display: flex; flex-direction: column; }
  .fi-strain { display: flex; align-items: center; gap: 10px; }
  .fi-slider { position: relative; container-type: inline-size; width: min(40cqh, 22cqw); height: 10px; border-radius: 99px;
    background: linear-gradient(90deg, var(--fi-slider-a), var(--fi-slider-b)); }
  .fi-slider .fi-lane { align-items: center; }
  .fi-knob { flex: none; width: 15px; height: 15px; border-radius: 50%; box-sizing: border-box;
    background: var(--fi-knob); border: 3px solid var(--fi-card); transform: translateX(-50%); }
  .fi-facts { flex: none; display: flex; flex-direction: column; justify-content: center; gap: 4px;
    border-left: 2px solid var(--fi-track); padding-left: 4cqw; }
  .fi-1bit .fi-facts { border-left-style: dotted; border-left-color: #000; }
  .fi-donut { flex: 0 1 88cqh; min-width: 0; max-height: 88cqh; aspect-ratio: 1; margin-left: auto; }
  @container (max-aspect-ratio: 5/2) { .fi-facts { display: none; } }
  /* Rest and goals cards: text on top, art in the space below it. */
  .fi-art { flex: 1; min-height: 0; display: flex; justify-content: center; align-items: flex-end; margin: 4px -18px -10px; }
  .fi-art svg { height: 100%; max-height: 44cqh; max-width: 92%; display: block; }
  .fi-home--hh { flex-direction: row; }
  .fi-home--hh .fi-steps { flex: 1.3; }
  .fi-home--hh .fi-row { flex: 2; }
  .screen--portrait .fi-home--hh .fi-steps { flex-direction: column; align-items: flex-start; }
  .screen--portrait .fi-home--hh .fi-donut { margin: 0 auto; flex: 1 1 0; min-height: 0; max-height: none; }
  .fi-home--q { gap: 8px; }
  .fi-home--q .fi-row { gap: 8px; }
  .fi-home--q .fi-card { padding: 6px 12px; border-radius: 12px; }
  .fi-home--q .fi-row .fi-card { flex-direction: row; align-items: center; justify-content: space-between; gap: 8px; }
  .fi-home--q .fi-row .fi-card > * { white-space: nowrap; }
  .fi-home--q .fi-art, .fi-home--q .fi-chev, .fi-home--q .fi-capline, .fi-home--q .fi-facts, .fi-home--q .fi-strain-block { display: none; }
  /* Walk timer ring: sized from the layout (container query units), so it grows on TRMNL X. */
  .fi-cq { container-type: size; }
  .fi-ring { flex: none; display: block; }
  .fi-ring--full { width: min(88cqh, 50cqw); height: min(88cqh, 50cqw); }
  .fi-ring--hh { width: min(90cqh, 30cqw); height: min(90cqh, 30cqw); }
  .fi-ring--hv { width: min(60cqh, 80cqw); height: min(60cqh, 80cqw); }
  .fi-ring--q { width: min(86cqh, 42cqw); height: min(86cqh, 42cqw); }
  .fi-strip-bar { position: relative; container-type: inline-size; height: 26px; border-bottom: 2px solid #000; }
  .fi-strip-bar .fi-lane { align-items: flex-end; }
  .fi-strip-bar .fi-blk { flex: none; min-width: 6px; height: 16px; box-sizing: border-box; background: #000; }
  .fi-strip-bar .fi-blk--live { border: 2px solid #000; border-bottom: 0; background: #fff; }
  .fi-strip-bar .fi-now { flex: none; width: 0; height: 100%; border-left: 2px dotted #000; }
  .screen--lg .fi-strip-bar { height: 44px; border-bottom-width: 3px; }
  .screen--lg .fi-strip-bar .fi-blk { height: 28px; }
</style>
<script>
  // Colour e-ink: steps and walks in the Fi app's green, night sleep in its light purple and
  // naps in its dark purple. Black-and-white and grayscale screens are left exactly as they
  // are. Full-colour panels get Fi's own values; panels with a few inks get the nearest
  // framework colour, which the framework snaps to an ink (or a dither of one).
  // Mark an element with data-fi="activity|sleep|nap" to have it painted; an SVG shape names
  // the attribute to set in data-fi-attr (default stroke). data-fi="key" swaps a legend's
  // text for data-fi-color-text, because the light and dark roles differ on colour screens.
  // The home screen carries its own palettes in CSS; it only needs a class naming the screen.
  window.fiPaint = (function () {
    var HEX = { activity: "#5ECB76", sleep: "#935EF7", nap: "#5B0FCB" };
    var TOKEN = { activity: "green", sleep: "violet-55", nap: "violet-30" };
    function screenClass(node) {
      var screen = node && node.closest ? node.closest(".screen") : null;
      return screen ? String(screen.getAttribute("class") || "") : "";
    }
    function kind(node) {
      var cls = screenClass(node);
      if (/screen--color-full/.test(cls)) return "full";
      return /screen--color-/.test(cls) ? "inks" : "mono";
    }
    function fill(role, node) {
      var k = kind(node);
      if (k === "mono" || !HEX[role]) return null;
      if (k === "full") return { color: HEX[role], image: null };
      try { return window.TRMNLPaint.bg(TOKEN[role], { el: node }); } catch (e) { return null; }
    }
    // A Highcharts colour (or pattern) for a chart series, or null to keep the default ink.
    function chart(role, id) {
      var node = document.getElementById(id);
      var f = fill(role, node);
      if (!f) return null;
      if (!f.image) return f.color;
      try { return window.TRMNLPaint.toHighcharts(f); } catch (e) { return f.color; }
    }
    // Colour screens get the app's palette, 2- and 4-bit screens keep the solid greys, and
    // anything else is treated as 1-bit, where only outlines survive.
    function markHome() {
      var homes = document.querySelectorAll(".fi-home");
      for (var i = 0; i < homes.length; i++) {
        if (kind(homes[i]) !== "mono") homes[i].classList.add("fi-color");
        else if (!/screen--(2bit|4bit)/.test(screenClass(homes[i]))) homes[i].classList.add("fi-1bit");
      }
    }
    function run() {
      var nodes = document.querySelectorAll("[data-fi]");
      for (var i = 0; i < nodes.length; i++) {
        var node = nodes[i];
        var role = node.getAttribute("data-fi");
        if (role === "key") {
          if (kind(node) !== "mono") node.textContent = node.getAttribute("data-fi-color-text");
          continue;
        }
        var f = fill(role, node);
        if (!f) continue;
        if (node.namespaceURI === "http://www.w3.org/2000/svg") {
          var color = f.color;
          if (kind(node) === "inks") {
            try { color = window.TRMNLPaint.stroke(TOKEN[role], { el: node }).color || color; } catch (e) {}
          }
          node.setAttribute(node.getAttribute("data-fi-attr") || "stroke", color);
        } else if (f.image) {
          try { window.TRMNLPaint.apply(node, f); } catch (e) { node.style.background = f.color; }
        } else {
          node.style.background = f.color;
        }
      }
    }
    var tries = 0;
    function start() {
      if (document.readyState === "loading") {
        if (++tries < 200) setTimeout(start, 50);
        return;
      }
      markHome();
      if (!window.TRMNLPaint) {
        if (++tries < 200) setTimeout(start, 50);
        return;
      }
      try { run(); } catch (e) {}
    }
    return { chart: chart, kind: kind, start: start };
  })();
  fiPaint.start();
</script>
{% if fi_view != "walk" and fi_view != "home" %}
<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script src="https://trmnl.com/js/highcharts/12.3.0/pattern-fill.js"></script>
<script>
  // 7-day charts shared by the steps and sleep layouts. kind "steps": columns with a dashed
  // goal line; kind "sleep": night sleep stacked under naps, in hours.
  window.fiChart = function (el, kind, days, goal, opts) {
    opts = opts || {};
    var tries = 0;
    (function attempt() {
      if (!(window.TRMNLCharts && window.Highcharts && document.getElementById(el))) {
        if (++tries < 200) setTimeout(attempt, 50);
        return;
      }
      TRMNLCharts.watch(el, function () {
        var px = function (v) { return TRMNLPaint.px(v, { el: el }); };
        var font = { fontSize: px(opts.font || 16) + "px", textOutline: "none", fontWeight: "normal" };
        var k = function (v) { return v >= 1000 ? (v / 1000).toFixed(v >= 10000 ? 0 : 1).replace(/\.0$/, "") + "k" : String(v); };
        var labels = opts.labels !== false;
        var series = kind === "steps"
          ? [{
              name: "Steps",
              data: days.map(function (d) { return d.steps; }),
              color: fiPaint.chart("activity", el) || TRMNLCharts.series(0, 2, { el: el }),
              dataLabels: { enabled: labels, allowOverlap: true, crop: false, overflow: "allow", formatter: function () { return k(this.y); }, style: font }
            }]
          : [
              { name: "Nap", data: days.map(function (d) { return d.nap_h; }), color: fiPaint.chart("nap", el) || TRMNLCharts.series(1, 2, { el: el }) },
              { name: "Sleep", data: days.map(function (d) { return d.sleep_h; }), color: fiPaint.chart("sleep", el) || TRMNLCharts.series(0, 2, { el: el }) }
            ];
        return Highcharts.chart(el, TRMNLCharts.merge(TRMNLCharts.options({ el: el }), {
          chart: { type: "column", height: null, spacing: px([labels ? 18 : 4, 0, 0, 0]) },
          legend: { enabled: false },
          plotOptions: {
            series: { animation: false, enableMouseTracking: false, borderWidth: 0, pointPadding: 0.08, groupPadding: 0.06 },
            column: { stacking: kind === "sleep" ? "normal" : undefined }
          },
          series: series,
          xAxis: {
            categories: days.map(function (d) { return opts.narrow ? d.short : d.day; }),
            lineWidth: 0,
            tickLength: 0,
            labels: { style: font, rotation: 0, autoRotation: false }
          },
          yAxis: {
            title: { text: null },
            tickAmount: opts.ticks || 4,
            gridLineDashStyle: "shortdot",
            softMax: kind === "steps" ? goal : undefined,
            labels: {
              enabled: opts.axis !== false,
              style: font,
              formatter: function () { return kind === "steps" ? k(this.value) : this.value + "h"; }
            },
            stackLabels: {
              enabled: kind === "sleep" && labels,
              style: font,
              formatter: function () { return this.total.toFixed(1); }
            },
            plotLines: kind === "steps" && goal ? [{ value: goal, width: px(2), dashStyle: "Dash", color: "#000000", zIndex: 5 }] : []
          }
        }));
      });
    })();
  };
</script>
{% endif %}

{% comment %} Fi Homescreen style: the app's Steps, Rest and rank cards. Fi does not share the
   rank with this sign-in, so the third card shows this week's step-goal days on the podium.
   Shapes with class fi-ol are the outlines drawn only on 1-bit screens. {% endcomment %}
{% template fi_home %}
{% case size %}
  {% when "full" %}
    {% assign fi_t = "title lg:title--large" %}
    {% assign fi_v = "value value--large lg:value--xlarge value--tnums" %}
    {% assign fi_v2 = "value value--base lg:value--large value--tnums" %}
    {% assign fi_s = "value value--small lg:value--base value--tnums" %}
  {% when "q" %}
    {% assign fi_t = "title title--small lg:title--base" %}
    {% assign fi_v = "value value--small lg:value--base value--tnums" %}
    {% assign fi_v2 = "value value--xsmall lg:value--small value--tnums" %}
    {% assign fi_s = "value value--xsmall lg:value--small value--tnums" %}
  {% else %}
    {% assign fi_t = "title title--small lg:title--base" %}
    {% assign fi_v = "value value--base lg:value--large value--tnums" %}
    {% assign fi_v2 = "value value--small lg:value--base value--tnums" %}
    {% assign fi_s = "value value--xsmall lg:value--small value--tnums" %}
{% endcase %}
{% assign fi_l = "label label--small lg:label--base" %}
<div class="fi-home fi-home--{{ size }}">
  <div class="fi-card fi-steps">
    <div class="fi-steps-text">
      <span class="{{ fi_t }}">Steps</span>
      <span class="{{ fi_v }}">{{ today.steps_label }}</span>
      {% if strain %}
      <div class="fi-strain-block">
        <span class="{{ fi_l }}">Strain · {{ strain.level | downcase | capitalize }}</span>
        <div class="fi-strain"><span class="{{ fi_s }}">{{ strain.score }}</span><div class="fi-slider"><div class="fi-lane"><div class="shrink-0 w--[{{ strain.pct | round | at_least: 0 | at_most: 100 }}cqw]"></div><div class="fi-knob"></div></div></div></div>
      </div>
      {% endif %}
    </div>
    <div class="fi-facts">
      <span class="{{ fi_l }}">Goal</span><span class="{{ fi_s }}">{{ today.goal_label }}</span>
      {% if today.to_go != "0" %}<span class="{{ fi_l }}">To go</span><span class="{{ fi_s }}">{{ today.to_go }}</span>{% else %}<span class="{{ fi_l }}">Today</span><span class="{{ fi_s }}">Goal met</span>{% endif %}
      <span class="{{ fi_l }}">Distance</span><span class="{{ fi_s }}">{{ today.distance }}</span>
    </div>
    <svg class="fi-donut" viewBox="0 0 200 200" font-family="Inter, Helvetica, Arial, sans-serif">
      <circle class="fi-s-track" cx="100" cy="100" r="80" fill="none" stroke-width="40"></circle>
      <circle class="fi-ol" cx="100" cy="100" r="99" fill="none" stroke="#000" stroke-width="2"></circle>
      <circle class="fi-ol" cx="100" cy="100" r="61" fill="none" stroke="#000" stroke-width="2"></circle>
      <circle cx="100" cy="100" r="80" fill="none" stroke-width="40" stroke-linecap="round" stroke-dasharray="{{ today.ring_dash }}" transform="rotate(-90 100 100)" class="fi-s-ring"></circle>
      <text x="100" y="101" text-anchor="middle" font-size="31" font-weight="600" class="fi-f-ring-text">{{ today.pct }}%</text>
      <text x="100" y="128" text-anchor="middle" font-size="21" class="fi-f-muted">of goal</text>
    </svg>
  </div>
  <div class="fi-row">
    <div class="fi-card">
      <span class="{{ fi_t }}">Rest</span>
      <div class="fi-capline"><span class="{{ fi_l }}">Naps today</span><span class="{{ fi_l }}">Night {{ today.sleep }}</span></div>
      <span class="{{ fi_v2 }}">{{ today.nap }}</span>
      <svg class="fi-chev" viewBox="0 0 11 19"><path d="M2 2 L9 9.5 L2 17" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="fi-s-chev"></path></svg>
      <div class="fi-art"><svg viewBox="0 0 420 100" preserveAspectRatio="xMidYMax meet">
        <g class="fi-ol" fill="#000" stroke="#000" stroke-width="8"><circle cx="300" cy="68" r="44"></circle><circle cx="362" cy="88" r="32"></circle><circle cx="250" cy="92" r="28"></circle><rect x="250" y="86" width="150" height="20"></rect></g>
        <g class="fi-f-cloud-b"><circle cx="300" cy="68" r="44"></circle><circle cx="362" cy="88" r="32"></circle><circle cx="250" cy="92" r="28"></circle><rect x="250" y="86" width="150" height="20"></rect></g>
        <g class="fi-f-cloud-a"><circle cx="150" cy="58" r="50"></circle><circle cx="82" cy="90" r="38"></circle><circle cx="220" cy="90" r="38"></circle><rect x="82" y="86" width="138" height="20"></rect></g>
        <g fill="none" stroke-width="5" stroke-linejoin="round" class="fi-s-zz"><path d="M338 30 h16 l-16 16 h16"></path><path d="M362 8 h22 l-22 24 h22"></path></g>
      </svg></div>
    </div>
    <div class="fi-card">
      <span class="{{ fi_t }}">Goals</span>
      <div class="fi-capline"><span class="{{ fi_l }}">This week</span><span class="{{ fi_l }}">Avg {{ week.avg_steps }}</span></div>
      <span class="{{ fi_v2 }}">{{ week.goal_days }}/{{ week.day_count }}{% unless size == "q" %} days{% endunless %}</span>
      <svg class="fi-chev" viewBox="0 0 11 19"><path d="M2 2 L9 9.5 L2 17" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="fi-s-chev"></path></svg>
      <div class="fi-art"><svg viewBox="0 0 420 100" preserveAspectRatio="xMidYMax meet">
        <rect x="20" y="52" width="128" height="60" rx="8" class="fi-f-pod-side"></rect>
        <rect x="272" y="52" width="128" height="60" rx="8" class="fi-f-pod-side"></rect>
        <rect class="fi-ol" x="20" y="52" width="128" height="60" rx="8" fill="none" stroke="#000" stroke-width="6"></rect>
        <rect class="fi-ol" x="272" y="52" width="128" height="60" rx="8" fill="none" stroke="#000" stroke-width="6"></rect>
        <rect x="146" y="14" width="128" height="98" rx="8" class="fi-f-pod-mid"></rect>
        <g class="fi-trophy"><path d="M320 0 h32 v4 q0 18 -16 22 q-16 -4 -16 -22 z" stroke="none"></path><path d="M320 4 h-7 q0 12 10 13 M352 4 h7 q0 12 -10 13" fill="none" stroke-width="4"></path><rect x="333" y="25" width="6" height="12" stroke="none"></rect><rect x="324" y="36" width="24" height="10" rx="2" stroke="none"></rect></g>
      </svg></div>
    </div>
  </div>
</div>
{% endtemplate %}

{% comment %} Walk timer: the ring, one drawing per state. {% endcomment %}
{% template fi_ring %}
{% assign ink = "#000" %}
<svg xmlns="http://www.w3.org/2000/svg" class="fi-ring fi-ring--{{ size }}" viewBox="0 0 230 230" font-family="Inter, Helvetica, Arial, sans-serif">
  {% if state == "due" %}
    {% assign ink = "#fff" %}
    <circle cx="115" cy="115" r="107" fill="#000"></circle>
  {% elsif state == "walking" %}
    <circle data-fi="activity" cx="115" cy="115" r="100" fill="none" stroke="#000" stroke-width="14" stroke-dasharray="26 13.27"></circle>
  {% elsif state == "morning" %}
    <circle cx="115" cy="115" r="100" fill="none" stroke="#000" stroke-width="3" stroke-linecap="round" stroke-dasharray="3 9"></circle>
  {% else %}
    <circle cx="115" cy="115" r="100" fill="none" stroke="#000" stroke-width="2" stroke-dasharray="2 7"></circle>
    <circle data-fi="activity" cx="115" cy="115" r="100" fill="none" stroke="#000" stroke-width="14" stroke-linecap="round" stroke-dasharray="{{ dash }}" transform="rotate(-90 115 115)"></circle>
  {% endif %}
  {% if state == "morning" %}
    <g transform="translate(73 50) scale(1.75)" fill="none" stroke="#000" stroke-width="2.6" stroke-linecap="round"><path d="M10 26a14 14 0 0 1 28 0"></path><line x1="2" y1="26" x2="46" y2="26"></line><line x1="24" y1="2" x2="24" y2="7"></line><line x1="8" y1="9" x2="11.5" y2="12.5"></line><line x1="40" y1="9" x2="36.5" y2="12.5"></line><line x1="12" y1="31" x2="36" y2="31"></line></g>
    <text x="115" y="142" text-anchor="middle" font-size="23" font-weight="600" fill="#000">{{ line1 }}</text>
    <text x="115" y="168" text-anchor="middle" font-size="23" font-weight="600" fill="#000">{{ line2 }}</text>
  {% else %}
    <g transform="translate(95 42) scale(1.67)" fill="{{ ink }}"><ellipse cx="4.8" cy="10.2" rx="2.2" ry="2.8"></ellipse><ellipse cx="9.3" cy="5.4" rx="2.2" ry="2.8"></ellipse><ellipse cx="14.7" cy="5.4" rx="2.2" ry="2.8"></ellipse><ellipse cx="19.2" cy="10.2" rx="2.2" ry="2.8"></ellipse><path d="M12 11c-3.5 0-7 4.6-7 7.4 0 1.9 1.5 2.6 3 2.6 1.6 0 2.6-.8 4-.8s2.4.8 4 .8c1.5 0 3-.7 3-2.6C19 15.6 15.5 11 12 11z"></path></g>
    <text x="115" y="138" text-anchor="middle" font-size="46" font-weight="600" fill="{{ ink }}">{{ big }}</text>
    <text x="115" y="163" text-anchor="middle" font-size="15" fill="{{ ink }}">{{ sub }}</text>
  {% endif %}
</svg>
{% endtemplate %}

{% template fi_status %}
{% if state == "due" %}
<span class="label label--filled text--bold lg:label--large">{{ status }}</span>
{% else %}
<span class="label text--bold lg:label--large">{{ status }}</span>
{% endif %}
{% endtemplate %}

{% comment %} Walk timer: today's walks on a 6am to 10pm strip. {% endcomment %}
{% template fi_strip %}
<div class="flex flex--row flex--between w--full">
  <span class="label text--bold lg:label--large">Today's walks</span>
  <span class="label label--small lg:label--base">{% if strip.known %}{{ strip.summary }}{% else %}History unavailable{% endif %}</span>
</div>
<div class="w--full">
  <div class="fi-strip-bar">
    {% for b in strip.blocks %}<div class="fi-lane"><div class="shrink-0 w--[{{ b.left | round | at_least: 0 | at_most: 100 }}cqw]"></div><div {% unless b.live %}data-fi="activity" {% endunless %}class="fi-blk{% if b.live %} fi-blk--live{% endif %} w--[{{ b.width | round | at_least: 1 | at_most: 100 }}cqw]"></div></div>{% endfor %}
    {% if strip.show_now %}<div class="fi-lane"><div class="shrink-0 w--[{{ strip.now | round | at_least: 0 | at_most: 100 }}cqw]"></div><div class="fi-now"></div></div>{% endif %}
  </div>
  <div class="flex flex--row flex--between w--full">{% for a in axis %}<span class="label label--small lg:label--base">{{ a }}</span>{% endfor %}</div>
</div>
{% endtemplate %}

{% comment %} One title bar for every screen; the home screen carries the Fi logo, the others a
   paw. compact drops the time where the bar is narrow. {% endcomment %}
{% template fi_title_bar %}
<div class="title_bar">
  {% if view == "home" %}
  <div class="image">
    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 100 100"><g fill="#000000"><path d="M12 83 L29 83 L44 36 Q47 29 56 29 L61 29 L65 17 L54 17 Q35 17 29 33 Z"/><path d="M17 54 L52 54 L56.5 40 L21.5 40 Z"/><path d="M67 29 L83 29 L87 17 L71 17 Z"/><path d="M48 83 L64 83 L78.5 37 L62.5 37 Z"/></g></svg>
  </div>
  {% else %}
  <div class="image image-stroke image-stroke--large">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="#000000"><ellipse cx="4.8" cy="10.2" rx="2.2" ry="2.8"/><ellipse cx="9.3" cy="5.4" rx="2.2" ry="2.8"/><ellipse cx="14.7" cy="5.4" rx="2.2" ry="2.8"/><ellipse cx="19.2" cy="10.2" rx="2.2" ry="2.8"/><path d="M12 11c-3.5 0-7 4.6-7 7.4 0 1.9 1.5 2.6 3 2.6 1.6 0 2.6-.8 4-.8s2.4.8 4 .8c1.5 0 3-.7 3-2.6C19 15.6 15.5 11 12 11z"/></g></svg>
  </div>
  {% endif %}
  <span class="title">{{ pet.name | default: "Fi Dog Tracker" }}</span>
  <span class="instance">{% if error %}Fi error{% elsif sample %}Sample data · add your Fi login{% elsif view == "walk" %}{% if demo %}Preview · {{ walk.label }}{% else %}{{ walk.label }}{% if walk.goal_note %} · {{ walk.goal_note }}{% endif %}{% unless compact %} · {{ updated }}{% endunless %}{% endif %}{% else %}{% if pet.status %}{{ pet.status }} · {% endif %}{% if pet.battery %}{{ pet.battery }}% battery · {% endif %}{{ updated }}{% endif %}</span>
</div>
{% endtemplate %}

{% template fi_error %}
<div class="layout layout--col layout--center gap--small">
  <span class="title">Couldn't load Fi data</span>
  <span class="description text--center">{{ error }}</span>
  <span class="label label--small">{% if error contains "password" or error contains "sign-in" %}Check the Fi email and password in the plugin settings.{% else %}Will try again on the next refresh.{% endif %}</span>
</div>
{% endtemplate %}
