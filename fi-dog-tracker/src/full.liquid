{% assign fi_view = view | default: trmnl.plugin_settings.custom_fields_values.view | default: "home" %}
{% if error %}
  {% render "fi_error", error: error %}
{% elsif fi_view == "home" %}
<div class="layout fi-home-layout">
  {% render "fi_home", size: "full", today: today, strain: strain, week: week %}
</div>
{% elsif fi_view == "walk" %}
<div class="layout layout--col layout--stretch-x fi-cq">
  <div class="flex flex--row flex--center-y gap--xlarge w--full">
    {% render "fi_ring", size: "full", state: walk.state, big: walk.big, sub: walk.sub, line1: walk.line1, line2: walk.line2, dash: walk.ring.dash %}
    <div class="flex flex--col flex--left gap--small grow">
      <span class="value value--small lg:value--large">{{ walk.label }}</span>
      {% render "fi_status", state: walk.state, status: walk.status %}
      <span class="label label--small lg:label--base">Walk due after {{ walk.limit }} without a walk</span>
      {% if walk.goal_note %}<span class="label label--small hidden lg:visible">Today: {{ walk.goal_note }}</span>{% endif %}
      <div class="divider"></div>
      {% render "fi_strip", strip: walk.strip, axis: walk.axis %}
    </div>
  </div>
</div>
{% elsif fi_view == "today" %}
<div class="layout layout--col layout--stretch-x gap--large">
  <div class="grid grid--cols-2 gap--xlarge">
    <div class="flex flex--col gap--small">
      <span class="label lg:label--large">Steps today</span>
      <span class="value value--xxlarge lg:value--xxxlarge value--tnums">{{ today.steps_label }}</span>
      <div class="progress-bar w--full">
        <div class="content">
          <span class="label label--small lg:label--base">{{ today.pct }}% of {{ today.goal_label }}</span>
          <span class="value value--xxsmall lg:value--small">{% if today.to_go != "0" %}{{ today.to_go }} to go{% else %}Goal reached{% endif %}</span>
        </div>
        <div class="track"><div class="fill" data-fi="activity" style="width: {{ today.bar_pct }}%"></div></div>
      </div>
    </div>
    <div class="flex flex--col gap--small">
      <span class="label lg:label--large">{{ today.sleep_title | default: "Sleep today" }}</span>
      <span class="value value--xxlarge lg:value--xxxlarge value--tnums">{{ today.sleep }}</span>
      <span class="label label--small lg:label--base">+ {{ today.nap }} naps · {{ today.rest }} rest</span>
    </div>
  </div>
  <div class="divider"></div>
  <div class="grid grid--cols-4 lg:portrait:grid--cols-2">
    <div class="item"><div class="meta"></div><div class="content">
      <span class="value value--base lg:value--large value--tnums">{{ today.distance }}</span>
      <span class="label label--small lg:label--base">Distance today</span>
    </div></div>
    <div class="item"><div class="meta"></div><div class="content">
      <span class="value value--base lg:value--large value--tnums">{{ week.avg_steps }}</span>
      <span class="label label--small lg:label--base">Avg steps, 7 days</span>
    </div></div>
    <div class="item"><div class="meta"></div><div class="content">
      <span class="value value--base lg:value--large value--tnums">{{ week.avg_sleep }}</span>
      <span class="label label--small lg:label--base">Avg sleep, 7 days</span>
    </div></div>
    <div class="item"><div class="meta"></div><div class="content">
      <span class="value value--base lg:value--large value--tnums">{% if pet.battery %}{{ pet.battery }}%{% else %}–{% endif %}</span>
      <span class="label label--small lg:label--base">Collar battery</span>
    </div></div>
  </div>
</div>
{% elsif fi_view == "week" %}
<div class="layout layout--col layout--stretch-x layout--top gap--medium">
  <div class="grid grid--cols-5 lg:portrait:grid--cols-3">
    <div class="item"><div class="meta"></div><div class="content">
      <span class="value value--small lg:value--base value--tnums">{{ week.steps_label }}</span>
      <span class="label label--small lg:label--base">Steps, 7 days</span>
    </div></div>
    <div class="item"><div class="meta"></div><div class="content">
      <span class="value value--small lg:value--base value--tnums">{{ week.avg_steps }}</span>
      <span class="label label--small lg:label--base">Avg per day</span>
    </div></div>
    <div class="item"><div class="meta"></div><div class="content">
      <span class="value value--small lg:value--base value--tnums">{{ week.goal_days }}/{{ week.day_count }}</span>
      <span class="label label--small lg:label--base">Goal days</span>
    </div></div>
    <div class="item"><div class="meta"></div><div class="content">
      <span class="value value--small lg:value--base value--tnums">{{ week.avg_sleep }}</span>
      <span class="label label--small lg:label--base">Avg sleep</span>
    </div></div>
    <div class="item"><div class="meta"></div><div class="content">
      <span class="value value--small lg:value--base value--tnums">{{ week.avg_nap }}</span>
      <span class="label label--small lg:label--base">Avg naps</span>
    </div></div>
  </div>
  <div class="grid grid--cols-2 gap--large grow">
    <div class="flex flex--col gap--xsmall h--full">
      <span class="label label--small lg:label--base">Steps per day · dashed line = goal</span>
      <div id="fi-steps-full" class="w--full grow"></div>
    </div>
    <div class="flex flex--col gap--xsmall h--full">
      <span class="label label--small lg:label--base">Sleep per day (h) · <span data-fi="key" data-fi-color-text="light = night, dark = naps">dark = night, light = naps</span></span>
      <div id="fi-sleep-full" class="w--full grow"></div>
    </div>
  </div>
</div>
<script>
  var fiDays = {{ days | json }};
  fiChart("fi-steps-full", "steps", fiDays, {{ today.goal | default: 0 }}, { fill: true, font: 14 });
  fiChart("fi-sleep-full", "sleep", fiDays, 0, { fill: true, font: 14 });
</script>
{% else %}
<div class="layout layout--col layout--stretch-x layout--top gap--medium">
  <div class="grid grid--cols-4 lg:portrait:grid--cols-2">
    <div class="item"><div class="meta"></div><div class="content">
      <span class="value value--base lg:value--large value--tnums">{{ today.steps_label }}</span>
      <span class="label label--small lg:label--base">Steps today</span>
    </div></div>
    <div class="item"><div class="meta"></div><div class="content">
      <span class="value value--base lg:value--large value--tnums">{{ today.sleep }}</span>
      <span class="label label--small lg:label--base">{{ today.sleep_title | default: "Sleep today" }} · +{{ today.nap }} naps</span>
    </div></div>
    <div class="item"><div class="meta"></div><div class="content">
      <span class="value value--base lg:value--large value--tnums">{{ week.avg_steps }}</span>
      <span class="label label--small lg:label--base">Avg steps, 7 days</span>
    </div></div>
    <div class="item"><div class="meta"></div><div class="content">
      <span class="value value--base lg:value--large value--tnums">{{ week.avg_sleep }}</span>
      <span class="label label--small lg:label--base">Avg sleep, 7 days</span>
    </div></div>
  </div>
  <div class="progress-bar">
    <div class="content">
      <span class="label label--small lg:label--base">Today: {{ today.pct }}% of {{ today.goal_label }} step goal · {{ today.distance }}</span>
      <span class="value value--xxsmall lg:value--small">{% if today.to_go != "0" %}{{ today.to_go }} to go{% else %}Goal reached{% endif %}</span>
    </div>
    <div class="track"><div class="fill" data-fi="activity" style="width: {{ today.bar_pct }}%"></div></div>
  </div>
  <div class="grid grid--cols-2 gap--large grow">
    <div class="flex flex--col gap--xsmall h--full">
      <span class="label label--small lg:label--base">Steps per day · dashed line = goal</span>
      <div id="fi-steps-both" class="w--full grow"></div>
    </div>
    <div class="flex flex--col gap--xsmall h--full">
      <span class="label label--small lg:label--base">Sleep per day (h) · <span data-fi="key" data-fi-color-text="light = night, dark = naps">dark = night, light = naps</span></span>
      <div id="fi-sleep-both" class="w--full grow"></div>
    </div>
  </div>
</div>
<script>
  var fiDays = {{ days | json }};
  fiChart("fi-steps-both", "steps", fiDays, {{ today.goal | default: 0 }}, { fill: true, font: 14 });
  fiChart("fi-sleep-both", "sleep", fiDays, 0, { fill: true, font: 14 });
</script>
{% endif %}
{% render "fi_title_bar", view: fi_view, pet: pet, walk: walk, updated: updated, demo: demo, sample: sample, error: error %}
